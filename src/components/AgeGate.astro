---
import LangToggle from './LangToggle.astro';
import { ui, withBase, type Lang, type PageKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: PageKey;
}

const { lang, page } = Astro.props;
const t = ui[lang].ageGate;
---

<div class="gate" role="dialog" aria-modal="true" aria-labelledby="gate-question" data-age-gate>
  <div class="glow" aria-hidden="true"></div>

  <div class="gate-top">
    <LangToggle lang={lang} page={page} />
  </div>

  <div class="panel">
    <img class="mark" src={withBase('/logo.webp')} alt="" width="72" height="72" />
    <p class="eyebrow">{t.eyebrow}</p>
    <p class="brand">The Green Room</p>
    <p id="gate-question" class="question">{t.question}</p>
    <p class="note">{t.note}</p>

    <div class="choices" data-gate-choices>
      <button class="btn btn-primary" type="button" data-gate-yes>{t.yes}</button>
      <button class="btn btn-ghost" type="button" data-gate-no>{t.no}</button>
    </div>

    <p class="denied" role="alert" hidden data-gate-denied>{t.denied}</p>
  </div>
</div>

<script>
  const gate = document.querySelector<HTMLElement>('[data-age-gate]');
  const site = document.getElementById('site');
  const root = document.documentElement;

  if (gate && site) {
    const close = () => {
      root.classList.add('age-ok');
      site.removeAttribute('inert');
    };

    if (root.classList.contains('age-ok')) {
      close();
    } else {
      site.setAttribute('inert', '');
      gate.querySelector<HTMLButtonElement>('[data-gate-yes]')?.focus();
    }

    gate.querySelector('[data-gate-yes]')?.addEventListener('click', () => {
      try {
        localStorage.setItem('gr-age-ok', '1');
      } catch {}
      close();
    });

    gate.querySelector('[data-gate-no]')?.addEventListener('click', () => {
      gate.querySelector<HTMLElement>('[data-gate-choices]')?.setAttribute('hidden', '');
      gate.querySelector<HTMLElement>('[data-gate-denied]')?.removeAttribute('hidden');
    });
  }
</script>

<style>
  .gate {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 24px 16px;
    background: var(--bg);
    overflow-y: auto;
  }

  :global(html.age-ok) .gate {
    display: none;
  }

  .glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 50% 0%, rgba(111, 214, 143, 0.16), transparent 70%),
      radial-gradient(50% 40% at 50% 100%, rgba(122, 90, 38, 0.18), transparent 70%);
    pointer-events: none;
  }

  .gate-top {
    position: absolute;
    top: 16px;
    right: 16px;
  }

  .panel {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 14px;
    max-width: 520px;
    text-align: center;
  }

  .mark {
    display: block;
    width: 72px;
    height: 72px;
    margin-bottom: 8px;
    border-radius: 18px;
    object-fit: cover;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
  }

  .eyebrow::before {
    display: none;
  }

  .brand {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 10vw, 4.5rem);
    text-transform: uppercase;
    line-height: 0.95;
    letter-spacing: 0.02em;
  }

  .question {
    font-family: var(--font-body);
    font-size: clamp(1.15rem, 3vw, 1.4rem);
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.3;
    margin-top: 12px;
  }

  .note {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .choices {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 16px;
  }

  .choices[hidden],
  .denied[hidden] {
    display: none;
  }

  .denied {
    margin-top: 16px;
    padding: 14px 18px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--text);
  }
</style>
