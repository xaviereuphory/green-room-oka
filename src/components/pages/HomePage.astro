---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StayHighScene from '../StayHighScene.astro';
import Smoke from '../Smoke.astro';
import OpenStatus from '../OpenStatus.astro';
import { site, fullAddress, directionsUrl } from '../../data/site';
import { routes, ui, venues, ratingLabels, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const h = t.home;
const rating = ratingLabels(lang);
---

<BaseLayout lang={lang} page="home" overlayHeader>
  <!-- Fond de fumée fixe : reste derrière toute la page, jusqu'à la section finale. -->
  {site.effects.smoke && <Smoke layer="back" />}

  <!-- Ouverture : scène 3D avec le logo et l'enseigne -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <h1 class="visually-hidden">The Green Room</h1>
      <StayHighScene />
      <p class="eyebrow">{h.eyebrow}</p>
      <p class="lead hero-lead">{h.lead}</p>
      <div class="ctas">
        <a class="btn btn-primary" href={routes.visit[lang]}>{h.ctaVisit}</a>
        <a class="btn btn-ghost" href={site.phoneHref}>{h.ctaCall} · {site.phone}</a>
      </div>
      <div class="hero-info">
        <OpenStatus lang={lang} />
        <a href={directionsUrl} target="_blank" rel="noopener">{fullAddress}</a>
      </div>
    </div>

    {site.effects.smoke && <Smoke layer="front" />}
  </section>

  <!-- Les volets : liste courte. Une ligne devient cliquable dès qu'on lui donne un `href`. -->
  <section class="section">
    <div class="container venues-wrap">
      <div class="venues-head">
        <p class="eyebrow">{h.venuesEyebrow}</p>
        <h2>{h.venuesTitle}</h2>
      </div>

      <ul class="venues">
        {venues.map((v, i) => {
          const Tag = v.href ? 'a' : 'div';
          return (
            <li>
              <Tag class:list={['venue', { 'is-link': v.href }]} href={v.href?.[lang]}>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <span class="name">{v.name[lang]}</span>
                <span class="kind">{v.kind[lang]}</span>
                {v.href && <span class="arrow" aria-hidden="true">→</span>}
              </Tag>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- Appel final, avec la note publique -->
  <section class="cta" data-smoke-end>
    <div class="container cta-inner">
      <p class="rating">
        <span class="stars" aria-hidden="true">★</span>
        <strong>{rating.score}</strong> {h.ratingOutOf}
        <span class="sep" aria-hidden="true">·</span>
        {h.ratingCount(rating.count)}
      </p>
      <h2>{h.ctaTitle}</h2>
      <p class="lead">{h.ctaText}</p>
      <div class="ctas">
        <a class="btn btn-primary" href={routes.visit[lang]}>{h.ctaButton}</a>
        <a class="btn btn-ghost" href={site.phoneHref}>{site.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Accueil : scène 3D */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr;
    isolation: isolate;
    overflow: clip;
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 50% at 50% 35%, rgba(70, 160, 60, 0.2), transparent 70%),
      radial-gradient(50% 40% at 50% 100%, rgba(122, 90, 38, 0.14), transparent 70%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    align-self: center;
    display: grid;
    justify-items: center;
    gap: 22px;
    text-align: center;
    padding-top: calc(var(--header-h) + 48px);
    padding-bottom: 56px;
  }

  .hero-inner .eyebrow::before {
    display: none;
  }

  .hero-lead {
    max-width: 44ch;
    color: var(--text);
    opacity: 0.85;
  }

  .hero .ctas {
    justify-content: center;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  /* Statut et adresse : texte flottant sous les boutons */
  .hero-info {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 22px;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .hero-info a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .hero-info a:hover {
    color: var(--accent);
  }

  /* Volets : titre à gauche, liste compacte à droite */
  .venues-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .venues-head {
    display: grid;
    gap: 18px;
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }

  .venues {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .venue {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 16px;
    padding: 18px 4px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .venue.is-link {
    grid-template-columns: 36px minmax(0, 1fr) auto 20px;
    transition: background 0.2s;
  }

  .num {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .name {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.1;
    transition: color 0.2s;
  }

  .kind {
    font-size: 0.85rem;
    color: var(--muted);
    text-align: right;
  }

  .arrow {
    color: var(--muted);
    transition: transform 0.2s, color 0.2s;
  }

  .venue.is-link:hover .name,
  .venue.is-link:hover .arrow {
    color: var(--accent);
  }

  .venue.is-link:hover .arrow {
    transform: translateX(4px);
  }

  @media (max-width: 860px) {
    .venues-wrap {
      grid-template-columns: 1fr;
    }
    .venues-head {
      position: static;
    }
  }

  @media (max-width: 420px) {
    .venue {
      grid-template-columns: 28px minmax(0, 1fr) auto;
      gap: 12px;
    }
    .kind {
      font-size: 0.78rem;
    }
  }

  /* Appel final */
  .cta {
    padding-block: clamp(80px, 12vw, 150px);
    border-top: 1px solid var(--line);
    background:
      radial-gradient(60% 80% at 50% 100%, rgba(111, 214, 143, 0.14), transparent 70%),
      var(--bg);
    text-align: center;
  }

  .cta-inner {
    display: grid;
    justify-items: center;
    gap: 20px;
  }

  .rating {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 4px 8px;
    padding: 8px 16px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .rating strong {
    color: var(--text);
    font-weight: 600;
  }

  .stars {
    color: var(--accent);
  }

  .cta .ctas {
    justify-content: center;
  }
</style>
