---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../PageHead.astro';
import OpenStatus from '../OpenStatus.astro';
import { site, fullAddress, directionsUrl, mapsEmbedUrl } from '../../data/site';
import { ui, hoursLabel, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].visit;
const hours = hoursLabel(lang);
---

<BaseLayout lang={lang} page="visit">
  <PageHead eyebrow={t.eyebrow} title={t.title} intro={t.intro} />

  <section class="section">
    <div class="container layout">
      <div class="col">
        <!-- Heures -->
        <article class="card">
          <div class="card-head">
            <h2>{t.hoursTitle}</h2>
            <span class="pill">{t.everyDay}</span>
          </div>
          <OpenStatus lang={lang} />
          <table class="hours">
            <caption class="visually-hidden">{t.hoursTitle}</caption>
            <tbody>
              {t.days.map((day, i) => (
                <tr data-day={(i + 1) % 7}>
                  <th scope="row">{day}<span class="today-tag" hidden>{t.today}</span></th>
                  <td>{hours}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </article>

        <!-- Nous joindre -->
        <article class="card">
          <h2>{t.contactTitle}</h2>
          <a class="contact-row" href={site.phoneHref}>
            <span class="contact-label">{t.call}</span>
            <span class="contact-value">{site.phone}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="contact-row" href={`mailto:${site.email}`}>
            <span class="contact-label">{t.write}</span>
            <span class="contact-value">{site.email}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>

          <h3 class="follow-title">{t.followTitle}</h3>
          <ul class="socials">
            {site.socials.map((s) => (
              <li><a href={s.href} target="_blank" rel="noopener">{s.name}</a></li>
            ))}
          </ul>
        </article>
      </div>

      <!-- Adresse et carte -->
      <article class="card map-card">
        <h2>{t.addressTitle}</h2>
        <p class="address">
          {site.address.street}<br />
          {site.address.city} ({site.address.community}), {site.address.region}<br />
          {site.address.postalCode}
        </p>
        <div class="map">
          <iframe
            title={t.mapTitle}
            src={mapsEmbedUrl}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
        <a class="btn btn-primary" href={directionsUrl} target="_blank" rel="noopener" aria-label={`${t.directions} : ${fullAddress}`}>
          {t.directions}
        </a>
      </article>
    </div>
  </section>
</BaseLayout>

<script>
  // Met en évidence la journée d'aujourd'hui (heure de Montréal).
  const weekday = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Toronto', weekday: 'short' }).format(new Date());
  const index = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(weekday);
  const row = document.querySelector<HTMLElement>(`.hours tr[data-day="${index}"]`);
  if (row) {
    row.classList.add('is-today');
    row.querySelector('.today-tag')?.removeAttribute('hidden');
  }
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 20px;
    align-items: start;
  }

  .col {
    display: grid;
    gap: 20px;
  }

  .card {
    display: grid;
    gap: 20px;
    padding: clamp(22px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .card h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.4rem);
  }

  .card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .pill {
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .hours {
    width: 100%;
    border-collapse: collapse;
  }

  .hours th,
  .hours td {
    padding: 12px 0;
    border-top: 1px solid var(--line);
    font-weight: 400;
    text-align: left;
  }

  .hours td {
    text-align: right;
    color: var(--muted);
    white-space: nowrap;
  }

  .hours :global(tr.is-today) th,
  .hours :global(tr.is-today) td {
    color: var(--text);
    font-weight: 600;
  }

  .today-tag {
    margin-left: 10px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: 2px;
  }

  .today-tag[hidden] {
    display: none;
  }

  .contact-row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'label arrow' 'value arrow';
    align-items: center;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }

  .contact-row + .contact-row {
    margin-top: -20px;
  }

  .contact-label {
    grid-area: label;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .contact-value {
    grid-area: value;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    overflow-wrap: anywhere;
    transition: color 0.2s;
  }

  .arrow {
    grid-area: arrow;
    font-size: 1.4rem;
    color: var(--muted);
    transition: transform 0.2s, color 0.2s;
  }

  .contact-row:hover .contact-value,
  .contact-row:hover .arrow {
    color: var(--accent);
  }

  .contact-row:hover .arrow {
    transform: translateX(4px);
  }

  .follow-title {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin-top: 4px;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: -8px 0 0;
    padding: 0;
    list-style: none;
  }

  .socials a {
    display: inline-block;
    padding: 8px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.88rem;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }

  .socials a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .address {
    font-size: 1.1rem;
  }

  .map {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface-2);
  }

  .map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    /* Carte assortie au thème sombre */
    filter: invert(0.9) hue-rotate(180deg) saturate(0.6) brightness(0.95);
  }

  .map-card .btn {
    justify-self: start;
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .map-card {
      order: -1;
    }
  }
</style>
