---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../PageHead.astro';
import FollowBlock from '../FollowBlock.astro';
import SampleTag from '../SampleTag.astro';
import { events } from '../../data/events';
import { ui, venues, dateParts, formatTime, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].events;
const sorted = [...events].sort((a, b) => (a.date + a.time).localeCompare(b.date + b.time));
const venueName = (id?: string) => venues.find((v) => v.id === id)?.name[lang];
---

<BaseLayout lang={lang} page="events">
  <PageHead eyebrow={t.eyebrow} title={t.title} intro={t.intro} />

  <section class="section">
    <div class="container">
      <ol class="events" data-events>
        {sorted.map((e) => {
          const d = dateParts(e.date, lang);
          const place = venueName(e.venue);
          return (
            <li class="event" data-date={e.date}>
              <time class="date" datetime={`${e.date}T${e.time}`}>
                <span class="day">{d.day}</span>
                <span class="month">{d.month}</span>
              </time>
              <div class="body">
                <p class="meta">
                  <span class="weekday">{d.weekday}</span> · {formatTime(e.time, lang)}
                  {place && <span class="place"> · {place}</span>}
                </p>
                <h2 class="title">{e.title[lang]}</h2>
                <p class="text">{e.text[lang]}</p>
              </div>
              {e.sample && <div class="tag"><SampleTag lang={lang} /></div>}
            </li>
          );
        })}
      </ol>

      <p class="empty" data-events-empty hidden={sorted.length > 0}>{t.empty}</p>
    </div>
  </section>

  <FollowBlock lang={lang} />
</BaseLayout>

<script>
  // Cache les événements passés (date de Montréal), sans avoir à republier le site.
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Toronto' }).format(new Date());
  const items = document.querySelectorAll<HTMLElement>('[data-events] [data-date]');
  let visible = 0;
  items.forEach((el) => {
    if ((el.dataset.date ?? '') < today) el.hidden = true;
    else visible++;
  });
  if (visible === 0) document.querySelector('[data-events-empty]')?.removeAttribute('hidden');
</script>

<style>
  .events {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .event {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(16px, 4vw, 40px);
    padding-block: clamp(22px, 3vw, 32px);
    border-bottom: 1px solid var(--line);
  }

  .event[hidden] {
    display: none;
  }

  .date {
    display: grid;
    justify-items: center;
    padding: 12px 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    line-height: 1;
  }

  .day {
    font-family: var(--font-display);
    font-size: 2.4rem;
    color: var(--accent);
  }

  .month {
    margin-top: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .body {
    display: grid;
    gap: 8px;
  }

  .meta {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .weekday {
    text-transform: capitalize;
    color: var(--text);
  }

  .title {
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    line-height: 1.05;
  }

  .text {
    color: var(--muted);
  }

  .empty {
    padding-block: 32px;
    color: var(--muted);
  }

  .empty[hidden] {
    display: none;
  }

  @media (max-width: 600px) {
    .event {
      grid-template-columns: 64px minmax(0, 1fr);
      align-items: start;
    }
    .day {
      font-size: 1.8rem;
    }
    .tag {
      grid-column: 2;
    }
  }
</style>
