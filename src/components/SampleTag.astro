---
// Petite étiquette « Exemple » sur le contenu de démonstration.
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<span class="sample">{ui[lang].sample}</span>

<style>
  .sample {
    display: inline-block;
    padding: 3px 9px;
    border: 1px dashed var(--line-strong);
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
</style>
